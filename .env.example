# Copy to .env (git-ignored) or export in your shell. Never commit real keys.

# LLM API key. Required. Read only from the environment; never persisted or logged.
READBACK_API_KEY=

# Any OpenAI-compatible chat-completions endpoint (OpenAI, OpenRouter, Ollama, ...).
READBACK_BASE_URL=https://api.openai.com/v1

# Model ID understood by the endpoint above. Required.
READBACK_MODEL=
